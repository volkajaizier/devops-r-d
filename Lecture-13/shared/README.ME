3.Get a list of all institutions with addresses and the number of children studying in each institution
SELECT 
    I.institution_name,
    I.address,
    COUNT(c.child_id) AS number_of_children
FROM 
    Institutions I
JOIN 
    Children C ON I.institution_id = C.institution_id
GROUP BY 
    I.institution_id;
